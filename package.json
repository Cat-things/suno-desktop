{
  "name": "suno-desktop",
  "productName": "Suno Desktop",
  "version": "0.1.0",
  "description": "Unofficial desktop app for Suno. Not affiliated with or endorsed by Suno, Inc.",
  "main": "./out/main/index.js",
  "author": "Cat-things",
  "license": "MIT",
  "homepage": "https://github.com/Cat-things/suno-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cat-things/suno-desktop.git"
  },
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "dist:win": "pnpm build && electron-builder --win --publish never",
    "dist:dir": "pnpm build && electron-builder --dir --publish never",
    "release": "pnpm build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
